# Environment for deploy/systemd/greylistd-frontend.service.
# Install as /etc/greylistd-frontend/env, mode 0600, owner root: it holds
# secrets. See README.rst ("Configuration") for every option.

# Only reachable through the local reverse proxy.
GREYLISTD_FRONTEND_LISTEN=127.0.0.1:8080
GREYLISTD_FRONTEND_TRUST_PROXY=true
GREYLISTD_FRONTEND_SOCKET=/var/run/greylistd/socket
GREYLISTD_FRONTEND_BASE_URL=https://greylist.example.com

# greylistd prints local timestamps without a zone. systemd services get no
# $TZ, so without this the frontend assumes UTC. Set it to the host's zone
# (timedatectl show -p Timezone --value).
GREYLISTD_FRONTEND_TIMEZONE=UTC

# Signs the session cookies; without it every restart logs everybody out.
# Generate with: openssl rand -hex 32
GREYLISTD_FRONTEND_SESSION_SECRET=

# OpenID Connect login. Register <base-url>/auth/oidc/callback as redirect URI.
#GREYLISTD_FRONTEND_OIDC_ISSUER=https://auth.example.com/o2
#GREYLISTD_FRONTEND_OIDC_CLIENT_ID=greylistd-frontend
#GREYLISTD_FRONTEND_OIDC_CLIENT_SECRET=
#GREYLISTD_FRONTEND_OIDC_PROVIDER_NAME=Example SSO
#GREYLISTD_FRONTEND_OIDC_ALLOWED_EMAILS=postmaster@example.com
#GREYLISTD_FRONTEND_OIDC_ALLOWED_GROUPS=mailadmins
#GREYLISTD_FRONTEND_OIDC_SCOPES=openid,email,profile,groups

# Optional (break-glass) password login, alone or next to OIDC.
#GREYLISTD_FRONTEND_AUTH_USERNAME=admin
#GREYLISTD_FRONTEND_AUTH_PASSWORD=
